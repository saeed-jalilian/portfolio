# Copy to /etc/portfolio/deploy.env (root:APP_USER, mode 640). KEY=value lines only; the
# bootstrap does this for you. Every key is optional: the values below are the defaults.

SITE_HOST=saeed-jalilian.ir
# Serve www.<SITE_HOST> as a permanent redirect to SITE_HOST (needs an A record for www).
WWW_REDIRECT=true

BASE=/srv/portfolio
APP_USER=portfolio
# The repository is public, so no deploy key is needed.
REPO_URL=https://github.com/saeed-jalilian/portfolio.git
DEFAULT_REF=main
KEEP_RELEASES=5
# Heap limit of the Next.js build (MB).
BUILD_HEAP_MB=1024

# haproxy: another project (mia-candle) already runs HAProxy on public 80/443 with Caddy
# behind it on loopback; the bootstrap adds SITE_HOST to HAProxy's hostname lists.
# none: Caddy owns 80/443 itself.
FRONT_ROUTER=haproxy

# Mirrors, when the npm registry is blocked from the server:
# NPM_REGISTRY=https://registry.npmjs.org
